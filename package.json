{
  "name": "dsh-general-automatic-memory",
  "version": "0.1.0",
  "description": "Cross-tool, human-editable, self-indexing long-term memory for DeepSeek Harness · 跨工具、可编辑、自索引的通用自动记忆",
  "type": "module",
  "icon": "icon.svg",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsdown -c tsdown.config.ts",
    "build:client": "tsdown -c tsdown.client.ts && node scripts/wrap-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "node scripts/verify-bundle.mjs",
    "check": "npm run typecheck && npm run build && npm run verify && npm run test",
    "prepack": "npm run build && npm run verify"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
